# App
APP_NAME=AI Cyber Defense Platform
ENV=development
API_PREFIX=/api

# Security (change in production!)
JWT_SECRET=change-me-in-production-9f8a7b6c5d4e3f2a1b0c
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma separated; * = allow all)
CORS_ORIGINS=*

# Database: PostgreSQL (Supabase). Leave empty to use the in-memory store.
# IMPORTANT: use the POOLER host (aws-0-<region>.pooler.supabase.com), NOT the
# direct host (db.<ref>.supabase.co). New Supabase projects expose the direct
# host over IPv6 only, and hosts like Render have no IPv6 route -> the app
# fails at startup with "OSError: [Errno 101] Network is unreachable".
# Get the exact string from Supabase dashboard -> Project Settings -> Database
# -> Connection pooling -> "Connection string" (transaction pooler, port 6543):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DATABASE_ECHO=false

# Models
MODEL_DIR=models

# Tier-2 calibration (tuned to the trained XGBoost margins)
XGB_CAL_SHIFT=-8.7
XGB_CAL_SCALE=1.5
XGB_CONF_THRESHOLD=0.5
XGB_HIGH_CONF_THRESHOLD=0.75

# Tier-1
TIER1_THRESHOLD=0.6

# RL policy
RL_MIN_CONFIDENCE=0.55
RL_EPSILON=0.15
RL_GAMMA=0.9
RL_LR=0.1
RL_EPSILON_DECAY=0.95
# Optional: path to an SB3 policy zip (skipped when empty)
RL_MODEL_PATH=

# Tier-0 rule cache
RULE_CACHE_TTL=10
LEARNED_RULE_TTL_SEC=3600

# Zero-day handling
ZERO_DAY_THREAT_FLOOR=0.7

# Pipeline pacing (seconds between live WebSocket stages)
STAGE_DELAY=0.35

# Honeypot
HONEYPOT_API_URL=

# Seed inert baseline rules at startup
SEED_RULES=true
